#!/usr/bin/env bash
set -euo pipefail
cd /rails

# Only server boots prepare data; consoles and one-off commands run as requested.
# Accept both the Thruster wrapper and rails server with additional Puma flags.
previous=""
for argument in "$@"; do
  if [[ "$previous" == */rails || "$previous" == rails ]] && [[ "$argument" == server || "$argument" == s ]]; then
    ./bin/rails db:prepare
    ./bin/rails i18n:sync
    break
  fi
  previous="$argument"
done

exec "$@"
