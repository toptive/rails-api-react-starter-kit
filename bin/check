#!/usr/bin/env bash
set -uo pipefail
cd "$(dirname "$0")/.."
if [[ "$(uname)" == "Darwin" ]]; then export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES; fi
failed=()
run() {
  local label="$1"
  shift
  printf '\n== %s ==\n' "$label"
  "$@" || failed+=("$label")
}
run "Ruby style" bundle exec rubocop
run "Architecture" bundle exec archspec check
run "Application security" bundle exec brakeman --no-pager -q
run "Gem security" bundle exec bundler-audit check --update
rails_tests() {
  local parallel=() serial=() path status=0
  while IFS= read -r path; do
    case "$path" in
      test/integration/admin_translation*_test.rb|test/integration/locales_test.rb|test/integration/runtime_i18n_test.rb|test/integration/solid_cable_translations_test.rb)
        serial+=("$path") ;;
      *) parallel+=("$path") ;;
    esac
  done < <(ruby -e 'puts Dir.glob("test/**/*_test.rb").sort')
  # libpq and Objective-C state inherited by fork are unsafe on macOS.
  if [[ "$(uname)" == "Darwin" ]]; then
    PARALLEL_WORKERS=1 bin/rails test "${parallel[@]}" || status=1
  else
    bin/rails test "${parallel[@]}" || status=1
  fi
  # Catalogue broadcasts cross worker databases; the Cable test spawns a process.
  PARALLEL_WORKERS=1 bin/rails test "${serial[@]}" || status=1
  return "$status"
}
run "Rails tests" rails_tests
run "Type contract" bin/rails contract:check
run "Translation contract" bin/rails i18n:check
run "Frontend types" pnpm typecheck
run "Frontend lint" pnpm lint
run "Frontend tests" pnpm test
run "Frontend security" pnpm audit --audit-level=high
run "Browser journeys" bin/e2e
if (( ${#failed[@]} )); then
  printf '\nFailed gate: %s\n' "${failed[@]}" >&2
  exit 1
fi
printf '\nAll gates green.\n'
