{
  "name": "starter-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cd frontend && vite",
    "build": "cd frontend && tsc --noEmit && vite build",
    "typecheck": "cd frontend && tsc --noEmit",
    "lint": "cd frontend && eslint . --max-warnings 0",
    "test": "cd frontend && vitest run",
    "i18n:build": "bin/rails i18n:build",
    "i18n:merge": "node i18n/scripts/merge-keys.mjs",
    "i18n:translate": "node i18n/scripts/translate.mjs"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
