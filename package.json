{
  "name": "starter-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cd frontend && VITE_DEV_API_URL=${VITE_DEV_API_URL:-http://localhost:3000} vite",
    "build": "VITE_OUT_DIR=${VITE_OUT_DIR:-../public} sh -c 'cd frontend && tsc -b && vite build && node scripts/prerender-landing.mjs'",
    "typecheck": "cd frontend && tsc -b",
    "lint": "eslint --config frontend/eslint.config.js --max-warnings 0 frontend/src frontend/e2e frontend/scripts frontend/*.config.* i18n/scripts && pnpm i18n:audit",
    "format": "prettier --write frontend/src",
    "test": "cd frontend && vitest run",
    "i18n:build": "bin/rails i18n:build",
    "i18n:merge": "node i18n/scripts/merge-keys.mjs",
    "i18n:translate": "node i18n/scripts/translate.mjs",
    "e2e": "playwright test --config frontend/playwright.config.ts",
    "e2e:ui": "playwright test --config frontend/playwright.config.ts --ui",
    "i18n:audit": "node i18n/scripts/audit.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@hookform/resolvers": "^5.2.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^17.0.15",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
